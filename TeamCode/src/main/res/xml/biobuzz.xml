<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <!-- Camera -->
    <Webcam name="Webcam 1" serialNumber="44E45CAF" />

    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Expansion Hub 2" port="2">
            <!-- motors (make the names match code !!!!!!!!!!!!!) -->
            <goBILDA5202SeriesMotor name="intake"            port="0" />
            <goBILDA5202SeriesMotor name="turretMotor"       port="3" />
            <goBILDA5202SeriesMotor name="shooterMotorLeft"  port="2" />
            <goBILDA5202SeriesMotor name="shooterMotorRight" port="1" />

            <!-- Servos -->

            <!-- I2C Digital Sensors -->
            <RevColorSensorV3 name="transferColorTop" port="0" bus="0"/>
            <RevColorSensorV3 name="transferColorRight" port="0" bus="1"/>
            <RevColorSensorV3 name="transferColorBottomBack" port="0" bus="2"/>
            <RevColorSensorV3 name="transferColorBottomFront" port="0" bus="3"/>

        </LynxModule>
        <LynxModule name="Control Hub" port="173">
            <!-- motors (make the names match code !!!!!!!!!!!!!) -->
            <goBILDA5202SeriesMotor name="leftFront_leftOdometry"    port="0" />
            <goBILDA5202SeriesMotor name="rightFront_centerOdometry" port="1" />
            <goBILDA5202SeriesMotor name="rightRear_rightOdometry"   port="2" />
            <goBILDA5202SeriesMotor name="leftRear"                  port="3" />

            <!-- Servos -->
            <Servo name="depollinatorServo"               port="0" />
            <ContinuousRotationServo name="transferServo" port="1" />
            <Servo name="shooterServo"                    port="2" />
            <Servo name="shooterHood"                    port="3" />

            <!-- I2C Digital Sensors -->
            <LynxEmbeddedIMU name="imu" port="0" bus="0" />
            <goBILDAPinpoint name="pinpoint" port="0" bus="1"/>
            <RevColorSensorV3 name="intakeColorRampBack" port="0" bus="0"/>
            <RevColorSensorV3 name="transferColorLeft" port="0" bus="2"/>
            <RevColorSensorV3 name="intakeColorRampFront" port="0" bus="3"/>

        </LynxModule>
    </LynxUsbDevice>

    <!-- Optional Limelight -->
    <!-- <EthernetDevice name="limelight" serialNumber="EthernetOverUsb:eth0:172.29.0.29" port="-1" ipAddress="172.29.0.1" /> -->
</Robot>
